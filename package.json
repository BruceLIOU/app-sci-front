{
	"name": "app-bailleurs-front",
	"version": "2.0.0",
	"description": "Frontend bailleurs — React 19 + Vite + TypeScript",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"lint": "biome check . --diagnostic-level=error",
		"lint:fix": "biome check --write . --diagnostic-level=error",
		"format": "biome format --write .",
		"commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
	},
	"dependencies": {
		"@coreui/chartjs": "^4.2.0",
		"@coreui/coreui": "^5.6.1",
		"@coreui/icons": "^3.0.1",
		"@coreui/icons-react": "^2.3.0",
		"@coreui/react": "^5.10.0",
		"@coreui/react-chartjs": "^3.0.0",
		"@coreui/utils": "^2.0.2",
		"@fullcalendar/core": "^6.1.20",
		"@fullcalendar/daygrid": "^6.1.20",
		"@fullcalendar/interaction": "^6.1.20",
		"@fullcalendar/list": "^6.1.20",
		"@fullcalendar/react": "^6.1.20",
		"@fullcalendar/timegrid": "^6.1.20",
		"@js-temporal/polyfill": "^0.5.1",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@reduxjs/toolkit": "^2.11.2",
		"@tailwindcss/vite": "^4.2.2",
		"axios": "^1.15.0",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"leaflet": "^1.9.4",
		"lucide-react": "^1.8.0",
		"react": "^19.2.5",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.2.5",
		"react-leaflet": "^5.0.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.14.0",
		"simplebar": "^6.3.3",
		"simplebar-react": "^3.3.2",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^22.19.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.10",
		"sass": "^1.99.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.8",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,scss,md}": "biome check --write --diagnostic-level=error --files-ignore-unknown=true"
